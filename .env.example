# Database connection string (PostgreSQL / Supabase / Neon / Local)
# Example: postgresql://postgres:password@localhost:5432/gold_peacock?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/gold_peacock?schema=public"

# Admin API Key for AI Agents to manage content
# Must match in Authorization: Bearer <ADMIN_API_KEY> or x-api-key: <ADMIN_API_KEY>
ADMIN_API_KEY="test-admin-secret-key-change-me"

# Optional: Next.js site URL for metadata / SEO
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Drive Background Watcher Polling Interval in minutes (default: 60 = 1 hour)
DRIVE_SYNC_INTERVAL_MINUTES=60

# Automatically publish new Google Drive content directly to live site (true / false)
AUTO_PUBLISH=true
